# Copy to .env and fill in. Never commit .env.
TWITTER_USERNAME=
TWITTER_PASSWORD=

MONGO_URI=mongodb://localhost:27017/
MONGO_DB=twitter_trends
MONGO_COLLECTION=trending_topics

# Optional proxy (host:port). For ProxyMesh use IP authentication; Chrome's
# --proxy-server flag cannot pass a username/password.
PROXY_SERVER=
IP_CHECK_URL=https://api.ipify.org?format=json

HEADLESS=false
WAIT_SECONDS=20

FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=false
